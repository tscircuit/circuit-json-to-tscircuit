<schematictext text={"To provide 5V Hall power, install jumpers JP1_2-3 and JP2."} schX={0.08328285887341025} schY={3.914294367050273} anchor={"bottom_left"} fontSize={0.18322228952150213} color={"#ee0e22"} schRotation={0} />
