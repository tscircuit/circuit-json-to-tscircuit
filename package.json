{
  "name": "circuit-json-to-tscircuit",
  "main": "dist/lib/index.js",
  "exports": {
    ".": "./dist/lib/index.js",
    "./cli": "./dist/cli/main.js"
  },
  "type": "module",
  "version": "0.0.49",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/circuit-json-to-tscircuit.git"
  },
  "scripts": {
    "build": "tsup-node lib/index.ts cli/main.ts --format esm --dts",
    "build:site": "bun build ./site/index.html --outdir site-build",
    "dev:site": "bun --hot ./site/index.html",
    "test": "bun test",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tscircuit/circuit-json-util": "^0.0.102",
    "@tscircuit/mm": "^0.0.8",
    "@tscircuit/soup-util": "^0.0.41",
    "@types/bun": "latest",
    "@types/react": "18",
    "@types/react-dom": "18",
    "bun-match-svg": "^0.0.15",
    "circuit-json": "^0.0.433",
    "circuit-to-svg": "^0.0.353",
    "commander": "^13.1.0",
    "prettier": "^3.9.5",
    "shiki": "^4.3.1",
    "stack-svgs": "^0.0.1",
    "transformation-matrix": "^2.16.1",
    "tscircuit": "^0.0.1873",
    "tsup": "^8.3.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@tscircuit/core": "0.0.1322"
  },
  "patchedDependencies": {
    "@tscircuit/core@0.0.1322": "patches/@tscircuit%2Fcore@0.0.1322.patch"
  }
}
